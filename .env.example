# Environment example for Loan Management System

# ==========================================
# Backend Configuration (backend/.env)
# ==========================================
NODE_ENV=development
PORT=5000

# MongoDB connection string (use either MONGO_URI or MONGODB_URI)
MONGO_URI=mongodb://localhost:27017/loan-management
#MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# File uploads
UPLOAD_DIR=uploads

# ==========================================
# Frontend Configuration (frontend/.env.local)
# ==========================================
# Replace this with your backend's API URL in production
NEXT_PUBLIC_API_URL=http://localhost:5000
